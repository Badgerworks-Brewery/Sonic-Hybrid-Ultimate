+// Object", "Stage Setup", "Ring", "Monitor", "Star Post" and so on - so in a merged
+// pack a script asking for "Stage Setup" gets whichever game registered that name
+// first, and a Sonic 1 stage silently ends up running Sonic 2's Stage Setup.
+//
+// Scoping the scan needs to know which game each object type belongs to and which
+// game is running. `objectTypeSplit` is the number of *global* object types
+// belonging to game 0; game 0 owns types [0, split) and game 1 the rest, which is
+// how the merged config lists them. Stage objects take their game from the stage
+// folder's S1/S2 suffix instead, because only one stage's objects are registered
+// at a time and their names never collide across games.
+//
+// A negative split disables the scoping entirely and restores the original
+// single-game behaviour, so a pack that does not opt in behaves exactly as before.
+extern int objectTypeGame[OBJECT_COUNT];
+extern int objectTypeSplit;         // < 0 disables scoping
+extern int objectTypeGlobalCount;   // globals occupy types [1, this]; stage objects follow
+extern int currentObjectGame;       // 0 or 1
+
+// Where game 1's numbering starts: type constants were baked against each game's
+// own table, and Sonic 1's objects all moved up by objectTypeSplit when the two
+// games were merged. Read from ObjectGameSplit.bin; both are 0 for a single-game
+// pack, which leaves every number untouched.
+extern int objectTypeBaseForGame1;
+extern int scriptFunctionBaseForGame1;
+
+// Where a *stage's* own script object types start in the merged table, minus where
+// they started in their own game. Needed by the two opcodes that create an object,
+// because a stage's script bakes its own stage-local types as indices too:
+//
+//     stage type T  ->  T + (globalTotal - thatGame'sGlobalCount)
+//
+// A stage's types begin at globalCount + 1 in their own game and at globalTotal + 1
+// in the merged table, so the offset is the difference between those two starts. It
+// is not simply objectTypeSplit, because the two games have different numbers of
+// globals: for Sonic 1 it works out to 39 and for Sonic 2 to 38.
+//
+// Act *layout* files deliberately do not use this. The packer already resolves their
+// type indices by object name against the destination table, so they are already
+// destination indices; shifting them again was one of the two bugs that pushed Green
+// Hill's types past the end of the table.
+extern int stageTypeBase;
+
+// How many functions are loaded so far, which is where the next container's
+// function table starts. A stage's own functions are appended rather than
+// overwriting the globals', so a stage's scripts - whose operands are file-local,
+// and which repeat their game's global functions first - keep resolving correctly.
+extern int loadedFunctionCount;
+
+// The highest script type loaded so far. Globals fill [1, N] and a stage appends
+// after them, so this is where a script's types stop being real. Nothing enforces
+// it: an operand naming a type past this end creates an entity whose type matches
+// no script and which therefore never runs.
+extern int loadedScriptTypeCount;
+
+// Returns the object type whose registered name matches, preferring the running
+// game's, or OBJECT_COUNT if there is none.
+int FindObjectTypeByName(const char *name);
 extern ScriptFunction scriptFunctionList[FUNCTION_COUNT];
 
 extern int scriptCode[SCRIPTCODE_COUNT];
