diff --git a/RSDKv4/HeartbeatLog.h b/RSDKv4/HeartbeatLog.h
new file mode 100644
index 0000000..a2c0dd6
--- /dev/null
+++ b/RSDKv4/HeartbeatLog.h
@@ -0,0 +1,45 @@
+// Heartbeat instrumentation for the stage probes.
+//
+// WHY THIS EXISTS
+//
+// `scripts/probe_stages.py` drives the engine headlessly and needs to distinguish three
+// outcomes that all look identical from the outside: the frame loop never started, the frame
+// loop started and stalled mid-stage, or the frame loop ran and the stage simply never
+// finished. Without a marker at each phase boundary, all three produce an empty log and the
+// probe cannot say which one happened.
+//
+// This header exists so those markers are switchable rather than permanent. Every site is
+// wrapped in HYBRID_HEARTBEAT_LOG, which is off by default, so a release build carries no
+// per-frame logging cost and a debug run can be told to emit it. The 40-odd call sites across
+// RetroEngine.cpp, Scene.cpp, Object.cpp, Audio.cpp and main.cpp are deliberately not given
+// per-site configuration: the value of the markers is that they are all present or all absent,
+// because a half-instrumented engine produces logs that lie by omission.
+//
+// The one thing this must not do is change control flow. Every marker is a bare logging call
+// on its own line, never wrapped around a branch, so enabling or disabling HYBRID_HEARTBEAT_LOG
+// cannot alter behaviour. That is why the gate is a macro around a statement and not a runtime
+// flag inside the frame loop.
+
+#ifndef RSDKV4_HEARTBEAT_LOG_H
+#define RSDKV4_HEARTBEAT_LOG_H
+
+// Enabled by passing -DHYBRID_HEARTBEAT_LOG=1 (see Hybrid-RSDK-Main/CMakeLists.txt), or by
+// defining it before this header is included. Off by default.
+#ifndef HYBRID_HEARTBEAT_LOG
+#define HYBRID_HEARTBEAT_LOG 0
+#endif
+
+#if HYBRID_HEARTBEAT_LOG
+
+// Spelled out rather than aliased to PrintLog so that a reader grepping for "HEARTBEAT" finds
+// every marker in the source, including the ones this expands to. The gate itself is the only
+// place the logging call is named.
+#define HEARTBEAT_LOG(...) PrintLog(__VA_ARGS__)
+
+#else
+
+#define HEARTBEAT_LOG(...) ((void)0)
+
+#endif
+
+#endif // RSDKV4_HEARTBEAT_LOG_H
\ No newline at end of file
