 file(GLOB_RECURSE RMXBASE_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxbase/*.cpp)
 
+# [Sonic Hybrid Ultimate] A.I.R.'s MSVC build asks for <SDL/SDL.h>, which cannot resolve.
+#
+# librmx/source/rmxmedia_externals.h:30-36 picks the spelling by platform and compiler:
+#
+#   #ifdef PLATFORM_WINDOWS
+#     #if defined(__GNUC__)
+#       #include <SDL2/SDL.h>      <- GCC and Linux take this
+#     #else
+#       #include <SDL/SDL.h>       <- MSVC takes this
+#     #endif
+#
+# and every rmxmedia translation unit failed:
+#
+#   rmxmedia_externals.h(35,12): error C1083: Cannot open include file: 'SDL/SDL.h'
+#
+# These are the include DIRECTORIES. The spelling itself is fixed separately, in
+# patches/sonic3air/0015, because no include path can satisfy <SDL/SDL.h>: the vendored
+# SDL2 keeps its headers flat (include/SDL.h exists, include/SDL/ does not).
+#
+# TWO directories are needed. The source include dir for the headers, and SDL's GENERATED
+# include-config-<config>/SDL2, which holds the real SDL_config.h. With only the first,
+# SDL.h is found and then 195 translation units fail with
+#
+#   SDL_config.h(58,1): error C1189: #error Wrong SDL_config.h, check your include path?
+#
+# because the source tree's SDL_config.h is a dispatcher that falls back to
+# SDL_config_minimal.h, which is not a usable Windows config. The generated directory is
+# therefore listed FIRST so that "SDL_config.h" resolves to the generated one.
+#
+# target_include_directories(), not include_directories(): the latter reaches every
+# subdirectory added afterwards, including SDL's own add_subdirectory(), and that made
+# SDL's own source fail - SDL2-static.vcxproj : error C1189, compiling SDL_mslibc.c.
+#
+# Each call sits immediately after the add_library() it applies to, because CMake requires
+# the target to exist first. The target list covers only targets present in pristine A.I.R.:
+# `glew` and `sonic3air_game` are created by patches 0012 and 0013, applied later, so each
+# of those sets its own include directories.
+#
+# PUBLIC, not PRIVATE: rmxmedia's headers include SDL too, so anything linking rmxmedia
+# needs the same spelling on its include path.
+
+# Globbed rather than naming a config, so this holds for Debug and Release alike.
+file(GLOB AIR_SDL_GENERATED_CONFIG_DIRS
+	  "${CMAKE_CURRENT_BINARY_DIR}/include-config-*/SDL2")
+
+
 add_library(rmxbase ${RMXBASE_SOURCES})
+target_include_directories(rmxbase PUBLIC
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+)
 
 if (NOT CMAKE_VERSION VERSION_LESS "3.16.0")
 	target_precompile_headers(rmxbase PRIVATE ${WORKSPACE_DIR}/librmx/source/rmxbase.h)
@@ -199,6 +249,10 @@ file(GLOB_RECURSE RMXMEDIA_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/*.cpp
