diff --git a/Oxygen/sonic3air/build/_cmake/CMakeLists.txt b/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
index ed859405..93a0a011 100644
--- a/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
+++ b/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
@@ -198,6 +198,89 @@ target_link_libraries(rmxbase zlibstatic)
 file(GLOB_RECURSE RMXMEDIA_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/*.cpp
 								   ${WORKSPACE_DIR}/librmx/source/rmxmedia/_glew/*.c)
 
+# [Sonic Hybrid Ultimate] A.I.R.'s MSVC build asks for <SDL/SDL.h>, not <SDL2/SDL.h>.
+#
+# librmx/source/rmxmedia_externals.h:30-36 picks the spelling by platform and compiler:
+#
+#   #ifdef PLATFORM_WINDOWS
+#     #if defined(__GNUC__)
+#       #include <SDL2/SDL.h>      <- GCC and Linux take this
+#     #else
+#       #include <SDL/SDL.h>       <- MSVC takes this
+#     #endif
+#
+# Nothing provided that spelling, so every rmxmedia translation unit failed:
+#
+#   rmxmedia_externals.h(35,12): error C1083: Cannot open include file: 'SDL/SDL.h'
+#
+# The line that used to be here, `include_directories(SDL/include)`, never fixed it: "SDL"
+# is the binary directory name given to add_subdirectory() below, not a source path, so the
+# directory does not exist.
+#
+# TWO directories are required, and supplying one looks like success while failing:
+#
+#   framework/external/sdl/SDL2/include/SDL.h            the headers proper
+#   include-config-<config>/SDL2/SDL_config.h            generated by SDL's own CMake
+#
+# With only the first, SDL.h is found and then 195 files fail with
+#
+#   SDL_config.h(58,1): error C1189: #error Wrong SDL_config.h, check your include path?
+#
+# because the source tree's SDL_config.h is a dispatcher that #includes SDL_config_minimal.h.
+#
+# Deliberately target_include_directories() and not include_directories(): the latter applies
+# to every subdirectory added afterwards, including SDL's own add_subdirectory(), and the one
+# error that gave it away was SDL's own source failing to compile -
+#   SDL2-static.vcxproj : error C1189, compiling SDL_mslibc.c
+# PUBLIC because rmxmedia's headers include SDL as well, so anything linking it needs the same
+# spelling.
+
+file(GLOB AIR_SDL_GENERATED_CONFIG_DIRS
+	  "${CMAKE_CURRENT_BINARY_DIR}/include-config-*/SDL2")
+
+# Every A.I.R. target, because each of these compiles sources that reach rmxmedia_externals.h
+# directly or through rmxmedia.h. Scoping it to rmxmedia alone was not enough - the header is
+# included from rmxbase and from the engine's own sources too.
+target_include_directories(rmxbase PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(glew PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(rmxmedia PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(rmxext_oggvorbis PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(lemonscript PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(oxygen_netcore PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(oxygen PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
+target_include_directories(sonic3air_game PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
+
 add_library(rmxmedia ${RMXMEDIA_SOURCES})
 
 target_link_libraries(rmxmedia rmxbase)
