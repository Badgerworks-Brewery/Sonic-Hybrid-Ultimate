 file(GLOB_RECURSE RMXBASE_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxbase/*.cpp)
 
+# [Sonic Hybrid Ultimate] A.I.R.'s MSVC build asks for <SDL/SDL.h>, not <SDL2/SDL.h>.
+#
+# librmx/source/rmxmedia_externals.h:30-36 picks the spelling by platform and compiler:
+#
+#   #ifdef PLATFORM_WINDOWS
+#     #if defined(__GNUC__)
+#       #include <SDL2/SDL.h>      <- GCC and Linux take this
+#     #else
+#       #include <SDL/SDL.h>       <- MSVC takes this
+#     #endif
+#
+# Nothing provided that spelling, so every rmxmedia translation unit failed:
+#
+#   rmxmedia_externals.h(35,12): error C1083: Cannot open include file: 'SDL/SDL.h'
+#
+# The line that used to be here, `include_directories(SDL/include)`, never fixed it: "SDL"
+# is the binary directory name given to add_subdirectory() further down, not a source path, so
+# no such directory exists.
+#
+# TWO directories are needed, and supplying only the first looks like progress while failing:
+#
+#   framework/external/sdl/SDL2/include/SDL.h    the headers proper
+#   include-config-<config>/SDL2/SDL_config.h    generated by SDL's own CMake
+#
+# With only the first, SDL.h is found and 195 translation units then fail with
+#
+#   SDL_config.h(58,1): error C1189: #error Wrong SDL_config.h, check your include path?
+#
+# because the source tree's SDL_config.h is a dispatcher that #includes SDL_config_minimal.h.
+#
+# Each target below gets them individually, immediately after the add_library() that creates
+# it. Both the position and the target list are load-bearing, and both were wrong at least once:
+#
+#   - The calls must come after their add_library(). A block above them fails at configure time
+#     with "Cannot specify include directories for target ... which is not built by this
+#     project".
+#   - The target list covers only targets that exist in pristine A.I.R. `glew` and
+#     `sonic3air_game` are created by patches 0012 and 0013, which are applied after this one,
+#     so this patch cannot name them; each sets its own include directories.
+#
+# The calls are target_include_directories() and not include_directories(): the latter applies
+# to every subdirectory added afterwards, including SDL's own add_subdirectory(), which made
+# SDL's source fail - SDL2-static.vcxproj : error C1189, compiling SDL_mslibc.c.
+#
+# PUBLIC rather than PRIVATE, because rmxmedia's headers include SDL as well, so anything
+# linking rmxmedia needs the same spelling on its include path.
+
+# Globbed rather than naming a config, so this holds for Debug and Release alike.
+file(GLOB AIR_SDL_GENERATED_CONFIG_DIRS
+	  "${CMAKE_CURRENT_BINARY_DIR}/include-config-*/SDL2")
+
+
 add_library(rmxbase ${RMXBASE_SOURCES})
+target_include_directories(rmxbase PUBLIC
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+)
 
 if (NOT CMAKE_VERSION VERSION_LESS "3.16.0")
 	target_precompile_headers(rmxbase PRIVATE ${WORKSPACE_DIR}/librmx/source/rmxbase.h)
@@ -199,6 +255,10 @@ file(GLOB_RECURSE RMXMEDIA_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/*.cpp
 								   ${WORKSPACE_DIR}/librmx/source/rmxmedia/_glew/*.c)
 
 add_library(rmxmedia ${RMXMEDIA_SOURCES})
+target_include_directories(rmxmedia PUBLIC
