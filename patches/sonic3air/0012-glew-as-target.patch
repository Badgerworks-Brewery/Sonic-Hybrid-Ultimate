diff --git a/Oxygen/sonic3air/build/_cmake/CMakeLists.txt b/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
--- a/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
+++ b/Oxygen/sonic3air/build/_cmake/CMakeLists.txt
@@ -252,8 +252,30 @@ target_link_libraries(rmxbase zlibstatic)
 
 # rmxmedia
 
-file(GLOB_RECURSE RMXMEDIA_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/*.cpp
-								   ${WORKSPACE_DIR}/librmx/source/rmxmedia/_glew/*.c)
+# [Sonic Hybrid Ultimate] The bundled GLEW gets its own target instead of being globbed
+# into rmxmedia.
+#
+# It used to be compiled straight into rmxmedia, which put the GLEW symbols inside a library
+# every other target needs. A host that links its own GLEW - this project uses vcpkg's
+# glew32 - therefore cannot drop this copy by changing link order, and linking both is a
+# hard error:
+#
+#   rmxmedia.lib(glew.obj) : error LNK2005: glewInit already defined in glew32.lib(glew32.dll)
+#
+# Giving it a target makes exactly one copy linkable by either engine. Both copies are GLEW
+# 2.3.4 and both declare GLEWAPI as plain extern rather than dllimport, so there is no ABI
+# or calling-convention mismatch to reconcile - only a duplicate to avoid.
+file(GLOB_RECURSE RMXMEDIA_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/*.cpp)
+file(GLOB GLEW_SOURCES ${WORKSPACE_DIR}/librmx/source/rmxmedia/_glew/*.c)
+
+add_library(glew ${GLEW_SOURCES})
+target_include_directories(glew PUBLIC ${WORKSPACE_DIR}/librmx/source/rmxmedia/_glew)
+# This patch creates the target, so it supplies the SDL include directories itself - patch
+# 0004 is applied earlier and cannot name a target that does not exist yet.
+target_include_directories(glew PUBLIC
+	${AIR_SDL_GENERATED_CONFIG_DIRS}
+	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
+)
 
 add_library(rmxmedia ${RMXMEDIA_SOURCES})
 target_include_directories(rmxmedia PUBLIC
@@ -261,6 +283,8 @@ target_include_directories(rmxmedia PUBLIC
 	${WORKSPACE_DIR}/framework/external/sdl/SDL2/include
 )
 
+target_link_libraries(rmxmedia glew)
+
 target_link_libraries(rmxmedia rmxbase)
 if (BUILD_SDL_STATIC)
 	target_link_libraries(rmxmedia SDL2-static)
