 namespace lemon
 {
 	// Forward declaration of the nativized code lookup builder function
@@ -162,6 +166,20 @@ void EngineDelegate::onPreFrameUpdate()
 
 void EngineDelegate::onPostFrameUpdate()
 {
+	// [Sonic Hybrid Ultimate] Real-session restart self-test. Patch 0002 only proved
+	// the engine survives re-entry when each session stops right after script loading,
+	// which never creates a window, renders a frame, or runs a frame of gameplay. This
+	// counts real frames and quits the run loop through the same path the window-close
+	// button uses, so a session genuinely starts, runs, and is then torn down.
+	//
+	// See patches/sonic3air/0003-restart-realsession.patch.
+	if (sSelfTestFrameLimit > 0 && ++mSelfTestFrames >= sSelfTestFrameLimit)
+	{
+		RMX_LOG_INFO("=== RESTART REALTEST: reached frame " << mSelfTestFrames
+		             << ", quitting this session ===");
+		FTX::System->quit();
+	}
+
 	mGame.onPostUpdateFrame();
 }
 
