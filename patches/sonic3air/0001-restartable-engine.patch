@@ -84,6 +84,7 @@ class EngineMain : public SingleInstance<EngineMain>
 public:
 	static EngineDelegateInterface& getDelegate()  { return EngineMain::instance().mDelegate; }
 	static void earlySetup();
+	static void shutdownProcess();
 
 public:
 	EngineMain(EngineDelegateInterface& delegate_, ArgumentsReader& arguments);
@@ -123,6 +124,10 @@ private:
 	EngineDelegateInterface& mDelegate;
 	ArgumentsReader& mArguments;
 
+	// [Sonic Hybrid Ultimate] Guards shutdownProcess() against being run twice; see
+	// patches/sonic3air/0001-restartable-engine.patch.
+	static bool sProcessShutDown;
+
 	struct Internal;
 	Internal& mInternal;
 
diff --git a/Oxygen/sonic3air/source/sonic3air/main.cpp b/Oxygen/sonic3air/source/sonic3air/main.cpp
index 6b34ea88..a8af95fe 100644
--- a/Oxygen/sonic3air/source/sonic3air/main.cpp
+++ b/Oxygen/sonic3air/source/sonic3air/main.cpp
@@ -115,5 +115,11 @@ int main(int argc, char** argv)
 		RMX_ERROR("Caught unhandled exception in main loop: " << e.what(), );
 	}
 
+	// [Sonic Hybrid Ultimate] execute() no longer performs process-wide teardown, so the
+	// standalone build has to ask for it explicitly. Without this the exe would exit
+	// without shutting down the audio system, the system framework, the job manager or
+	// logging. See patches/sonic3air/0001-restartable-engine.patch.
+	EngineMain::shutdownProcess();
+
 	return 0;
 }
